PORT=3000
NODE_ENV=development
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sla_csv
CORS_ORIGIN=http://localhost:5173
# Use different, long random values in every environment (openssl rand -hex 32).
ACCESS_TOKEN_SECRET=change-me-access-secret
REFRESH_TOKEN_SECRET=change-me-refresh-secret
# API base URL exposed to the browser via /config.js
# Same-origin monolith (default): /api/v1
API_BASE_URL=/api/v1
# Separate API host (only if frontend and API are on different domains):
# API_BASE_URL=https://your-production-domain.com/api/v1