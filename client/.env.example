# Optional build-time override for the API base URL.
# Production monolith deploys should rely on server API_BASE_URL + /config.js instead.
#
# Local dev with Vite proxy (default): leave unset — client uses /api/v1.
# Separate frontend deploy: set to your API host, e.g.
# VITE_API_BASE=https://your-production-domain.com/api/v1
