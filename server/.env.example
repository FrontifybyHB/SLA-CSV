PORT=3000
NODE_ENV=development
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sla_csv
# Comma-separated web origins allowed to call the API with cookies.
# Dev defaults (when unset): http://localhost:5173,http://localhost:5174
# Production example: CORS_ORIGIN=https://sla-csv.vercel.app,https://www.example.com
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
# Use different, long random values in every environment (openssl rand -hex 32).
ACCESS_TOKEN_SECRET=change-me-access-secret
REFRESH_TOKEN_SECRET=change-me-refresh-secret
REFRESH_TOKEN_PEPPER=change-me-pepper
# Cross-origin production (frontend on another domain) needs:
# COOKIE_SAME_SITE=none + COOKIE_SECURE=true (auto-default in production).
# Same-origin/single-domain can keep: COOKIE_SAME_SITE=lax
# COOKIE_SAME_SITE=lax
# COOKIE_SECURE=false
