# Optional: override the API base URL used by the client.
# Defaults to same-origin /api/v1 (works for production and local dev via Vite proxy).
#
# Only set this when the API is hosted on a different domain:
# VITE_API_BASE=https://your-production-domain.com/api/v1
#
# Local dev with client and server on separate ports (without Vite proxy):
# VITE_API_BASE=http://localhost:3000/api/v1
