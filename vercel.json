{
  "version": 2,
  "buildCommand": "npm run build:all",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "none",
  "outputDirectory": "server/public",
  "routes": [
    {
      "src": "/assets/(.*)",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      },
      "dest": "/assets/$1"
    },
    {
      "src": "/config.js",
      "dest": "/server/dist/server.js"
    },
    {
      "src": "/health",
      "dest": "/server/dist/server.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "/server/dist/server.js"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}