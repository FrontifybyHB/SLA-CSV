# API base used by the frontend (see src/shared/config/env.ts).
# Default when unset: /api/v1 (same-origin; dev Vite proxy + single-domain prod).
# Set an absolute URL ONLY when the backend is on a different origin, e.g.:
# VITE_API_BASE=https://sla-csv-server.onrender.com/api/v1
VITE_API_BASE=/api/v1
